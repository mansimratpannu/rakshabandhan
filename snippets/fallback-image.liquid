{%- comment %}
  Renders the asset filename for a given product handle.
  Accepts:
  - handle: {String} Product handle (optional, defaults to product.handle)
{% endcomment -%}
{%- liquid
  assign target_handle = handle | default: product.handle
  assign img = ""
  if target_handle == 'naksh-circular-beaded-rakhi'
    assign img = 'img_4901.jpg'
  elsif target_handle == 'naksh-tree-of-life-lumba-set'
    assign img = 'img_4902.jpg'
  elsif target_handle == 'madhav-kids-spiderman-4pack-rakhi'
