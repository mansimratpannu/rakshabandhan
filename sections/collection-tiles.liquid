{% comment %}
  Collection Tiles section. Displays 5 categories across desktop and 2 on mobile, featuring custom/collection images, titles, and item-count subtitles.
{% endcomment %}

<div id="CollectionTiles-{{ section.id }}" class="collection-tiles-section color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-title-wrapper text-{{ section.settings.heading_alignment }}">
        <h2 class="collection-tiles-heading h1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subtext != blank -%}
          <p class="collection-tiles-subtext">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-tiles-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign title = block.settings.title | default: collection.title
          assign image = block.settings.image | default: collection.featured_image | default: collection.products.first.featured_image
          assign count = collection.products_count | default: 0
          assign image_asset_name = blank
          
          # Force the link to use our tag-based filter to prevent 404s on uncreated collections
          assign link = block.settings.link
          if link == blank or link == '/collections/all' or count == 0 or collection == nil
            if title contains 'Classic'
              assign link = '/collections/all/thread'
            elsif title contains 'Bhaiya' or title contains 'Lumba'
              assign link = '/collections/all/lumba'
            elsif title contains 'Kids'
              assign link = '/collections/all/kids'
            elsif title contains 'Pooja' or title contains 'Thali'
              assign link = '/collections/all/thali'
            elsif title contains 'Hamper' or title contains 'Gourmet'
              assign link = '/collections/all/hamper'
            endif
          endif

          # Theme-side fallback logic for count and images if Shopify Admin collections are empty
          if count == 0 or collection == nil
            if title contains 'Classic'
              assign count = 6
              if image == blank
                assign image_asset_name = 'img_4901.jpg'
              endif
            elsif title contains 'Bhaiya' or title contains 'Lumba'
              assign count = 4
              if image == blank
                assign image_asset_name = 'img_4902.jpg'
              endif
            elsif title contains 'Kids'
              assign count = 3
              if image == blank
                assign image_asset_name = 'img_4905.jpg'
              endif
            elsif title contains 'Pooja' or title contains 'Thali'
              assign count = 3
              if image == blank
                assign image_asset_name = 'img_4911.jpg'
              endif
            elsif title contains 'Hamper' or title contains 'Gourmet'
              assign count = 4
              if image == blank
                assign image_asset_name = 'img_4884.png'
              endif
            endif
          endif
        -%}
        <a href="{{ link | default: '#' }}" class="collection-tile-card card-wrapper" {{ block.shopify_attributes }}>
          <div class="collection-tile-image-wrapper">
            {%- if image != blank -%}
              <img 
                src="{{ image | image_url: width: 350 }}" 
                alt="{{ title | escape }}"
                class="collection-tile-image"
                loading="lazy"
                width="150"
                height="150"
              >
            {%- elsif image_asset_name != blank -%}
              <img 
                src="{{ image_asset_name | asset_url }}" 
                alt="{{ title | escape }}"
                class="collection-tile-image"
                loading="lazy"
                width="150"
                height="150"
              >
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-tile-image placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-tile-info">
            <h3 class="collection-tile-title">{{ title | escape }}</h3>
            <span class="collection-tile-subtitle microcopy">
              {{ count }} {{ count | pluralize: 'item', 'items' }}
            </span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .collection-tiles-section {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding: 5rem 0;
  }
  .section-title-wrapper {
    margin-bottom: 4rem;
  }
  .section-title-wrapper.text-center {
    text-align: center;
  }
  .section-title-wrapper.text-left {
    text-align: left;
  }
  .collection-tiles-heading {
    margin: 0 0 1rem 0;
  }
  .collection-tiles-subtext {
    font-size: 1.4rem;
    color: rgba(36, 26, 20, 0.75);
    margin: 0;
  }
  .collection-tiles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  @media screen and (min-width: 768px) {
    .collection-tiles-grid {
      grid-template-columns: repeat(5, 1fr);
      gap: 2rem;
    }
  }
  .collection-tile-card {
    background-color: #F3E3D3 !important; /* Sandal tiles default #F3E3D3 */
    border: 1px solid rgba(201, 162, 39, 0.2); /* faint gold leaf hairline */
    padding: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .collection-tile-image-wrapper {
    width: 100px;
    height: 100px;
    border-radius: 50% !important; /* Circular badge style */
    border: 1px dashed #C9A227; /* Gold leaf dashed ring */
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--color-background);
    padding: 4px;
  }
  .collection-tile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50% !important;
    transition: transform 0.4s ease;
  }
  .collection-tile-card:hover .collection-tile-image {
    transform: scale(1.1);
  }
  .collection-tile-info {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .collection-tile-title {
    font-size: 1.6rem;
    margin: 0;
    color: #241A14; /* Ink */
  }
  .collection-tile-subtitle {
    font-size: 0.9rem;
    color: rgba(36, 26, 20, 0.6);
    display: inline-block;
  }
</style>

{% schema %}
{
  "name": "Collection Tiles",
  "tag": "section",
  "class": "section-collection-tiles",
  "max_blocks": 10,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Curated Rakhi Collections"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subheading Text",
      "default": "Find the perfect token of protection for your siblings"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title (Optional)",
          "info": "Overrides the default collection title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image (Optional)",
          "info": "Overrides the default collection image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link (Optional)",
          "info": "Overrides default collection link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Tiles",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
