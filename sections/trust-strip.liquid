{% comment %}
  Trust Strip: 4-cell hairline grid section highlighting brand value propositions.
{% endcomment %}

<div id="TrustStrip-{{ section.id }}" class="trust-strip-section color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="trust-strip-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'trust_cell' -%}
          <div class="trust-strip-cell" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="trust-cell-icon-wrapper">
                {{ block.settings.icon }}
              </div>
            {%- endif -%}
            <div class="trust-cell-content">
              <h3 class="trust-cell-title">{{ block.settings.heading | escape }}</h3>
              <p class="trust-cell-text">{{ block.settings.text | escape }}</p>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .trust-strip-section {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding: 4rem 0;
    border-top: 1px solid rgba(201, 162, 39, 0.2);
    border-bottom: 1px solid rgba(201, 162, 39, 0.2);
  }
  .trust-strip-grid {
    display: grid;
    grid-template-columns: 1fr;
    /* Hairline borders between cells */
    gap: 0;
    border: 1px solid rgba(201, 162, 39, 0.25); /* Gold leaf hairline container */
  }
  @media screen and (min-width: 576px) {
    .trust-strip-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media screen and (min-width: 990px) {
    .trust-strip-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .trust-strip-cell {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    box-sizing: border-box;
    /* Horizontal/vertical hairlines */
    border: 1px solid rgba(201, 162, 39, 0.15);
  }
  .trust-cell-icon-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 40px;
    width: 40px;
    color: #EFA92C; /* Marigold highlights for icons */
  }
  .trust-cell-icon-wrapper svg {
    width: 100%;
    height: 100%;
  }
  .trust-cell-content {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .trust-cell-title {
    font-size: 1.6rem;
    margin: 0;
    font-family: 'Marcellus', serif;
    color: #241A14; /* Ink */
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .trust-cell-text {
    font-size: 1.2rem;
    color: rgba(36, 26, 20, 0.7);
    margin: 0;
    line-height: 1.4;
  }
</style>

