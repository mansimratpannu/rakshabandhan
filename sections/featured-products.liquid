{% comment %}
  Featured Products 4-up grid with computed discount percentage tags, variant meta line, and asynchronous Add-to-Cart form submitting to /cart/add.js.
{% endcomment %}

<div id="FeaturedProducts-{{ section.id }}" class="featured-products-section color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-title-wrapper text-center">
        <h2 class="featured-products-heading h1">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subtext != blank -%}
          <p class="featured-products-subtext">{{ section.settings.subtext | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign collection = collections[section.settings.collection]
      assign products_limit = section.settings.products_to_show
    -%}

    <div class="products-grid-wrapper">
      <div class="featured-products-grid">
        {%- if collection != blank and collection.all_products_count > 0 -%}
          {%- for product in collection.products limit: products_limit -%}
            {% render 'featured-product-card', product: product %}
          {%- endfor -%}
        {%- else -%}
          <!-- Mockup/Placeholder Cards if no collection is selected -->
          {%- for i in (1..4) -%}
            <div class="featured-product-card card-wrapper">
              <div class="product-card-image-wrapper">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg product-card-image' }}
              </div>
              <div class="product-card-info">
                <h3 class="product-card-title">Artisanal Rakhi Set {{ i }}</h3>
                <p class="product-card-meta">Set size: 1 / Cotton thread</p>
                <div class="product-card-price-container">
                  <span class="price-item price-item--sale">₹499.00</span>
                  <span class="price-item price-item--compare">₹799.00</span>
                  <span class="product-discount-badge">37% OFF</span>
                </div>
                <button class="button button--secondary product-card-add-btn" disabled>Select Option</button>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .featured-products-section {
    background-color: var(--color-background);
    color: var(--color-foreground);
    padding: 6rem 0;
  }
  .featured-products-heading {
    margin: 0 0 1rem 0;
  }
  .featured-products-subtext {
    font-size: 1.5rem;
    color: rgba(36, 26, 20, 0.75);
    margin: 0;
  }
  .featured-products-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }
  @media screen and (min-width: 990px) {
    .featured-products-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 3rem;
    }
  }
  
  /* Shared Card Styling (can also reside in base.css or card CSS) */
  .featured-product-card {
    background-color: #FBF0E7; /* Sandal background */
    border: 1px solid rgba(201, 162, 39, 0.15); /* Gold leaf hairline */
    display: flex;
    flex-direction: column;
    height: 100%;
    position: relative;
    box-sizing: border-box;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }
  .product-card-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: #F3E3D3;
  }
  .product-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .featured-product-card:hover .product-card-image {
    transform: scale(1.05);
  }
  .product-card-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: #A3182B; /* Kumkum Red for badges */
    color: #FBF0E7;
    font-family: 'Space Mono', monospace;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.4rem 0.8rem;
    letter-spacing: 0.1em;
    z-index: 2;
    text-transform: uppercase;
  }
  .product-card-info {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.8rem;
  }
  .product-card-title {
    font-size: 1.8rem;
    margin: 0;
    line-height: 1.3;
  }
  .product-card-title a {
    color: #241A14; /* Ink */
    text-decoration: none;
  }
  .product-card-title a:hover {
    text-decoration: underline;
  }
  .product-card-meta {
    font-size: 1.1rem;
    color: rgba(36, 26, 20, 0.6);
    margin: 0;
    text-transform: uppercase;
    font-family: 'Space Mono', monospace;
    letter-spacing: 0.05em;
  }
  .product-card-price-container {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: auto;
  }
  .price-item--sale {
    font-size: 1.6rem;
    font-weight: 700;
    color: #241A14; /* Ink */
  }
  .price-item--compare {
    font-size: 1.3rem;
    text-decoration: line-through;
    color: rgba(36, 26, 20, 0.45);
  }
  .product-discount-badge {
    background-color: rgba(163, 24, 43, 0.1);
    color: #A3182B; /* Kumkum Red */
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border: 1px solid rgba(163, 24, 43, 0.2);
    font-family: 'Space Mono', monospace;
  }
  .product-card-add-btn {
    width: 100%;
    margin-top: 1.5rem;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 1.2rem;
    text-transform: uppercase;
    cursor: pointer;
    background-color: #EFA92C !important; /* Marigold */
    color: #12332C !important;
    border: 1px solid #EFA92C !important;
    transition: background-color 0.2s ease;
  }
  .product-card-add-btn:hover:not(:disabled) {
    background-color: #C9A227 !important; /* Gold Leaf */
    border-color: #C9A227 !important;
  }
  .product-card-add-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
</style>

<!-- AJAX Asynchronous add-to-cart Javascript -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.ajax-cart-form').forEach(form => {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        const submitBtn = form.querySelector('.product-card-add-btn');
        if (!submitBtn) return;
        
        submitBtn.disabled = true;
        const origText = submitBtn.innerText;
        submitBtn.innerText = 'ADDING...';

        const formData = new FormData(form);

        fetch(window.routes.cart_add_url, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/javascript'
          }
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Network error adding to cart');
          }
          return response.json();
        })
        .then(data => {
          submitBtn.innerText = 'ADDED!';
          
          // Dispatch global custom event for cart refresh (standard in OS 2.0 cart drawers)
          document.dispatchEvent(new CustomEvent('cart:updated', {
            bubbles: true,
            detail: { cart: data }
          }));

          // Fetch updated cart count to refresh header bubbles asynchronously
          fetch(window.routes.cart_url + '.js')
          .then(res => res.json())
          .then(cart => {
            document.querySelectorAll('.cart-count-bubble').forEach(bubble => {
              bubble.innerText = cart.item_count;
              bubble.classList.remove('hidden');
            });
            // Update cart drawer contents if active
            const cartDrawer = document.querySelector('cart-drawer');
            if (cartDrawer) {
              cartDrawer.classList.remove('is-empty');
              fetch(window.routes.cart_url + '?section_id=cart-drawer')
              .then(res => res.text())
              .then(html => {
                const parsed = new DOMParser().parseFromString(html, 'text/html');
                const inner = parsed.querySelector('#CartDrawer');
                if (inner && document.querySelector('#CartDrawer')) {
                  document.querySelector('#CartDrawer').innerHTML = inner.innerHTML;
                }
              });
            }
          });

          setTimeout(() => {
            submitBtn.innerText = origText;
            submitBtn.disabled = false;
          }, 2000);
        })
        .catch(err => {
          console.error(err);
          submitBtn.innerText = 'ERROR';
          setTimeout(() => {
            submitBtn.innerText = origText;
            submitBtn.disabled = false;
          }, 2000);
        });
      });
    });
  });
</script>

{% schema %}
{
  "name": "Featured Products Grid",
  "tag": "section",
  "class": "section-featured-products",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Celebrate with Gifting Store"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subheading Text",
      "default": "Handcrafted premium items for your brother and family"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to Pull"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Number of Products to Show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products Grid"
    }
  ]
}
{% endschema %}
